# ClickUp
CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxx

# Bitbucket (HTTP Basic Auth with email:api_token as the credential pair)
BITBUCKET_API_TOKEN=xxxxxxxxxxxxxxxxxx
BITBUCKET_EMAIL=you@example.com
BITBUCKET_WORKSPACE=your_workspace

# AWS Bedrock
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
REGION=us-east-1
AWS_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
